<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnOpenLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Чат (LinearLayout)" />

    <Button
        android:id="@+id/btnOpenConstraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="2. Чат (ConstraintLayout)" />

    <Button
        android:id="@+id/btnOpenFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="3. Просмотр картинок (FrameLayout)" />

</LinearLayout>