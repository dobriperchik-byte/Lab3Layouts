<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_standard">

    <!-- ScrollView привязан к верху экрана и к полю ввода -->
    <ScrollView
        android:id="@+id/scrollViewConstraint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/etMessageConstraint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="[ConstraintLayout Chat]\nПривет! Это окно чата на ConstraintLayout."
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Все элементы растягиваются и позиционируются с помощью якорей привязки."
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Поле ввода слева от кнопки -->
    <EditText
        android:id="@+id/etMessageConstraint"
        android:layout_width="0dp"
        android:layout_height="@dimen/input_field_height"
        android:hint="Введите сообщение..."
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSendConstraint"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Кнопка справа фиксированной ширины -->
    <Button
        android:id="@+id/btnSendConstraint"
        android:layout_width="@dimen/button_width"
        android:layout_height="@dimen/input_field_height"
        android:text="Отправить"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>